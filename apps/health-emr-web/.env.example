# Web app only. Next loads this for `next build` and `next start`.
PORT=3000
API_BASE_URL="http://localhost:4000"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-me-auth"

# Hosted intake forms. One key per client business, named by their slug:
# a patient's browser can never hold one, so the form posts through
# /api/intake/<slug> and the key is attached server-side.
# HOSTED_INTAKE_KEY_JOEYMED="hemr_…"
