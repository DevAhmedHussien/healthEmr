# Copy to `apps/health-emr-web/.env`.
#
# Separate from the API's file because both define PORT, and one shared value
# means the second app to start takes the first one's port.

# `npm run dev` defaults to 3005. Change it here and change CORS_ORIGINS in
# the API's file to match, or the browser's requests are refused.
PORT=3005

# Server-side only: what server components and the BFF proxy call.
API_BASE_URL="http://localhost:4000"

# Browser-side: what the chat websocket connects to, so it must be reachable
# from the user's machine rather than from the container.
#
# A separate variable because it is compiled into the client bundle, and the
# two are genuinely different addresses in most deployments. Setting only
# API_BASE_URL leaves chat silently pointing at the default below — which is
# the right port only by coincidence, and the wrong API the moment you run
# anything else on 4000.
NEXT_PUBLIC_API_ORIGIN="http://localhost:4000"

# Where this app is served from. Auth.js signs cookies against it, and a
# mismatch logs people out at apparently random intervals.
AUTH_URL="http://localhost:3005"
AUTH_SECRET="replace-me-auth"

# Hosted intake forms. One key per client business, named by their slug:
# a patient's browser can never hold one, so the form posts through
# /api/intake/<slug> and the key is attached server-side.
# HOSTED_INTAKE_KEY_JOEYMED="hemr_…"
