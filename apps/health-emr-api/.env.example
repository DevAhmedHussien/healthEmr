# Copy to `apps/health-emr-api/.env`.
#
# Here rather than at the repo root, because this is where both things that
# read it look: Nest resolves `.env` from the working directory, and every
# workspace script runs with its own package as the working directory. Prisma
# resolves it from the schema's directory, which is the same place. A file at
# the root is read by neither, and `prisma migrate` fails with the unhelpful
#   Validation Error: url = env("DATABASE_URL")

# --- database -------------------------------------------------------------
DATABASE_URL="postgresql://healthemr:healthemr@localhost:5455/healthemr?schema=public"

# --- api ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Any string of 8 characters or more will start; use real secrets anywhere
# a real patient could reach. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Where the consoles are served from. Must match the web app's port or every
# browser request is refused by CORS — `npm run dev` puts the web app on 3005.
CORS_ORIGINS="http://localhost:3005"

# Field-level PHI encryption. 32 bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Left empty the API still starts and warns, storing PHI in plaintext. That is
# for the first five minutes on a new machine and nowhere else.
PHI_ENCRYPTION_KEY=""
