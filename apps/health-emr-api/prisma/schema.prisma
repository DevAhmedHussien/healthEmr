// HealthEMR — multi-tenant telehealth EMR platform.
//
// Conventions, inherited from joeymed-backend so the team reads this fluently:
//   * uuid primary keys, @db.Uuid
//   * @db.Timestamptz(6) on every timestamp
//   * @@map to snake_case table names
//
// Tenancy rule: every tenant-scoped model carries `tenantId` as the leading
// column of its hot index. The Prisma tenant extension (src/common/prisma/
// tenant.extension.ts) injects it into every query so a forgotten `where`
// cannot leak across clients.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════════ enums ══

enum Role {
  SUPER_ADMIN
  ADMIN
  PROVIDER
  PHARMACY
  PATIENT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  /// Off the platform, but every record they touched is retained. Distinct from
  /// SUSPENDED, which is temporary and expects a return.
  ARCHIVED
}

/// Where a revenue figure came from, so a number on a chart can be traced.
enum RevenueSource {
  /// The telehealth business told us what they charged.
  TENANT_QUOTED
  /// We priced it from the tenant catalogue.
  PLATFORM_PRICED
}

/// Whether an applicant filled the public form, or a human keyed it in for them.
enum ApplicationSource {
  SELF_SERVE
  SUPER_ADMIN
}

enum EarningStatus {
  PENDING
  APPROVED_FOR_PAYOUT
  PAID
  VOID
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_REVOKED
  USER_CREATED
  USER_UPDATED
  USER_ROLE_CHANGED
  USER_DEACTIVATED
  TENANT_CREATED
  TENANT_UPDATED
  ENTITLEMENT_CHANGED
  PHI_READ
  PHI_CREATED
  PHI_UPDATED
  PHI_DELETED
  REQUEST_ROUTED
  REQUEST_DECIDED
  PRESCRIPTION_SIGNED
  PRESCRIPTION_VOIDED
  ORDER_SUBMITTED
  ORDER_STATUS_CHANGED
  BREAK_THE_GLASS
  ADMIN_CREATED
  INVITE_SENT
  INVITE_ACCEPTED
  APPLICATION_DECIDED
  ACCOUNT_SUSPENDED
  ACCOUNT_REACTIVATED
  PROVIDER_REASSIGNED
