// ═══════════════════════════════════════════════════════════════ tenancy ══

/// A client business. `slug` is the `company` field in the partner payload.
model Tenant {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(120)
  name             String       @db.VarChar(200)
  status           TenantStatus @default(ACTIVE)
  contactEmail     String       @db.VarChar(255)
  ownerName        String?      @db.VarChar(200)
  contactPhone     String?      @db.VarChar(40)
  billingPlan      String?      @db.VarChar(80)
  /// How many times this client may re-send a prescription on one visit.
  ///
  /// Contractual, so it sits on the account rather than in code. Two is the
  /// default: one correction for a genuine mistake, one more for the mistake
  /// in the correction. Past that a resend is a new clinical question and
  /// belongs in a new visit.
  rxRetryLimit     Int          @default(2)
  archivedAt       DateTime?    @db.Timestamptz(6)
  archivedReason   String?
  archivedByUserId String?      @db.Uuid
  /// States this tenant is commercially allowed to sell into. Empty = no limit
  /// beyond what provider licensing and StatePolicy already enforce.
  allowedStates    String[]     @default([])
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  users             User[]
  apiKeys           TenantApiKey[]
  webhooks          TenantWebhook[]
  categories        TenantCategory[]
  medications       TenantMedication[]
  pharmacies        TenantPharmacy[]
  providers         TenantProvider[]
  patients          TenantPatient[]
  encounters        Encounter[]
  submissions       QaSubmission[]
  requests          PrescriptionRequest[]
  orders            PharmacyOrder[]
  chatThreads       ChatThread[]
  invoices          Invoice[]
  auditLogs         AuditLog[]
  primaryProviders  ProviderProfile[]     @relation("ProviderPrimaryTenant")
  primaryPharmacies Pharmacy[]            @relation("PharmacyPrimaryTenant")
  providerEarnings  ProviderEarning[]
  prescriptions     Prescription[]

  @@index([status], map: "tenants_status_idx")
  @@map("tenants")
}

model TenantApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  name       String    @db.VarChar(120)
  /// Argon2 hash. The plaintext key is shown once, at creation, and never stored.
  keyHash    String    @unique
  /// Non-secret lookup prefix so a presented key can find its row in one query.
  keyPrefix  String    @unique @db.VarChar(16)
  scopes     String[]  @default([])
  lastUsedAt DateTime? @db.Timestamptz(6)
  expiresAt  DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId], map: "tenant_api_keys_tenant_idx")
  @@map("tenant_api_keys")
}

/// Where a client business wants to be told what happened, as it happens.
///
/// One row per endpoint, because a client commonly has more than one: a CRM
/// that shows a salesperson where a visit got to, and a fulfilment system that
/// only cares about shipping. Each subscribes to its own events, so neither is
/// sent traffic it has no use for.
model TenantWebhook {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  /// What this endpoint is for, in the operator's words. Two URLs at the same
  /// host are otherwise indistinguishable in a list.
  name         String            @db.VarChar(120)
  url          String            @db.VarChar(500)
  /// The bearer token their endpoint expects from us, encrypted at rest. Never
  /// readable back through the API — it can be replaced, not retrieved.
  authCipher   String
  /// Signing secret for the request signature, so they can prove the body came
  /// from us and was not altered. Generated here; shown once at creation.
  secretRef    String            @db.VarChar(255)
  events       String[]          @default([])
  isActive     Boolean           @default(true)
  /// Consecutive failures. Reset by the first success.
  failureCount Int               @default(0)
  lastAttemptAt DateTime?        @db.Timestamptz(6)
  lastSuccessAt DateTime?        @db.Timestamptz(6)
  lastError     String?
  /// Set when the platform stopped trying. A dead endpoint is switched off
  /// rather than retried forever, and the reason says which.
  disabledAt     DateTime?       @db.Timestamptz(6)
  disabledReason String?
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([tenantId, isActive], map: "tenant_webhooks_tenant_active_idx")
  @@map("tenant_webhooks")
}

model WebhookDelivery {
  id             String        @id @default(uuid()) @db.Uuid
  webhookId      String        @db.Uuid
  event          String        @db.VarChar(120)
  payload        Json
  responseStatus Int?
  responseBody   String?
  attempts       Int           @default(0)
  deliveredAt    DateTime?     @db.Timestamptz(6)
  nextRetryAt    DateTime?     @db.Timestamptz(6)
  /// Why it has not been delivered. Their message, not ours.
  lastError      String?
  /// The visit this was about, so a delivery can be read from the visit and a
  /// visit's whole outbound history read back.
  requestId      String?       @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  webhook        TenantWebhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([nextRetryAt], map: "webhook_deliveries_retry_idx")
  @@index([webhookId, createdAt], map: "webhook_deliveries_webhook_created_idx")
  @@map("webhook_deliveries")
}

/// Which visitTypes this tenant may submit. Gate for "Company does not have that visit type".
model TenantCategory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  categoryId String   @db.Uuid
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([tenantId, categoryId], map: "tenant_categories_unique")
  @@map("tenant_categories")
}

/// Which medIds this tenant may order. Gate for "No match for {medId}".
model TenantMedication {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  medicationId String     @db.Uuid
  isEnabled    Boolean    @default(true)
  /// A rate negotiated with this client for this medication, in integer cents.
  /// Overrides the pharmacy product's `sellPriceCents` wherever it is set, so a
  /// client keeps their price whichever contracted pharmacy fills the order.
  /// Null means they pay the standard price.
  priceCents   Int?
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, medicationId], map: "tenant_medications_unique")
  @@map("tenant_medications")
}

/// Which pharmacies this tenant may name. Gate for "Pharmacy mismatch in patientPreference".
model TenantPharmacy {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @db.Uuid
  pharmacyId         String   @db.Uuid
  isDefault          Boolean  @default(false)
  /// This tenant's own account identifier at that pharmacy.
  externalAccountRef String?  @db.VarChar(255)
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacy           Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pharmacyId], map: "tenant_pharmacies_unique")
  @@map("tenant_pharmacies")
}

/// The provider roster this tenant may draw on.
model TenantProvider {
  id           String          @id @default(uuid()) @db.Uuid
  tenantId     String          @db.Uuid
  providerId   String          @db.Uuid
  contractedAt DateTime        @default(now()) @db.Timestamptz(6)
  endedAt      DateTime?       @db.Timestamptz(6)
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, providerId], map: "tenant_providers_unique")
  @@map("tenant_providers")
}

// ══════════════════════════════════════════════════════ identity & audit ══

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String
  role            Role      @default(PATIENT)
  /// Required for ADMIN, null for every other role.
  tenantId        String?   @db.Uuid
  /// Which pharmacy this account works for. Staff were previously matched to a
  /// pharmacy by comparing their email to the pharmacy's contact address, which
  /// broke the moment either changed and silently locked the account out.
  pharmacyId      String?   @db.Uuid
  firstName       String    @db.VarChar(100)
  lastName        String    @db.VarChar(100)
  phone           String?   @db.VarChar(30)
  avatarUrl       String?   @db.VarChar(500)
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(true)
  mfaEnabled      Boolean   @default(false)
  lastLoginAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  tenant                  Tenant?                  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  pharmacy                Pharmacy?                @relation("PharmacyStaff", fields: [pharmacyId], references: [id], onDelete: SetNull)
  providerProfile         ProviderProfile?
  patient                 Patient?
  refreshSessions         RefreshSession[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  chatMessages            ChatMessage[]
  chatParticipations      ChatParticipant[]
  notifications           Notification[]
  invites                 UserInvite[]             @relation("InviteRecipient")
  invitesIssued           UserInvite[]             @relation("InviteIssuedBy")
  providerNotes           ProviderNote[]
  createdTemplates        QuestionnaireTemplate[]

  @@index([role], map: "users_role_idx")
  @@index([tenantId], map: "users_tenant_idx")
  @@index([pharmacyId], map: "users_pharmacy_idx")
  @@map("users")
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ip        String?   @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  revokedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_sessions_user_idx")
  @@index([expiresAt], map: "refresh_sessions_expires_idx")
  @@map("refresh_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

/// Append-only and hash-chained: each row's `hash` covers its own content plus
/// the previous row's hash, so a deleted or edited entry breaks the chain.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  /// Navigational only. Both foreign keys are SET NULL on delete, so neither is
  /// part of the chain hash — a deleted account must not be able to rewrite
  /// history by proxy. The immutable copies below are what the hash covers.
  tenantId    String?     @db.Uuid
  actorUserId String?     @db.Uuid
  /// Who acted and which account they acted for, as text, frozen at write time.
  /// Attribution has to outlive the records it refers to: the question "who did
  /// this" is asked years later, often precisely because the account is gone.
  actorEmail  String?     @db.VarChar(255)
  tenantSlug  String?     @db.VarChar(120)
  actorRole   Role?
  action      AuditAction
  entityType  String      @db.VarChar(120)
  entityId    String?     @db.VarChar(120)
  patientId   String?     @db.Uuid
  before      Json?
  after       Json?
  ip          String?     @db.VarChar(64)
  userAgent   String?
  requestId   String?     @db.VarChar(64)
  /// Monotonic per-chain position. Gaps are as suspicious as a bad hash.
  sequence    BigInt
  prevHash    String?     @db.VarChar(64)
  hash        String      @db.VarChar(64)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  actor  User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([sequence], map: "audit_logs_sequence_unique")
  @@index([tenantId, createdAt], map: "audit_logs_tenant_created_idx")
  @@index([patientId, createdAt], map: "audit_logs_patient_created_idx")
  @@index([action], map: "audit_logs_action_idx")
  @@map("audit_logs")
}

/// Machine identity for internal services. Replaces the blanket admin API key.
model ServiceAccount {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique @db.VarChar(120)
  keyHash    String    @unique
  keyPrefix  String    @unique @db.VarChar(16)
  scopes     String[]  @default([])
  lastUsedAt DateTime? @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@map("service_accounts")
}

// ════════════════════════════════════════════════════════ patient record ══

/// The person. Platform-level and deduplicated across tenants, because one human
/// may buy from two client businesses and must not end up with two charts.
model Patient {
  id                String    @id @default(uuid()) @db.Uuid
  mrn               String    @unique @db.VarChar(40)
  userId            String?   @unique @db.Uuid
  firstName         String    @db.VarChar(100)
  lastName          String    @db.VarChar(100)
  /// Encrypted at rest by the PHI extension.
  dob               String    @db.VarChar(255)
  sexAtBirth        Sex
  phone             String    @db.VarChar(30)
  email             String    @db.VarChar(255)
  addressLine1      String    @db.VarChar(200)
  addressLine2      String?   @db.VarChar(200)
  city              String    @db.VarChar(120)
  /// Where the patient lives. Not necessarily where they were when they submitted.
  residenceState    String    @db.VarChar(2)
  postalCode        String    @db.VarChar(20)
  idPhotoKey        String?   @db.VarChar(512)
  idPhotoVerifiedAt DateTime? @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user                 User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  tenantLinks          TenantPatient[]
  encounters           Encounter[]
  vitals               Vitals[]
  allergies            Allergy[]
  conditions           Condition[]
  medications          PatientMedication[]
  labResults           LabResult[]
  documents            PatientDocument[]
  submissions          QaSubmission[]
  requests             PrescriptionRequest[]
  prescriptions        Prescription[]
  chatThreads          ChatThread[]
  communicationConsent CommunicationConsent?
  invoices             Invoice[]

  /// The dedup key. Two submissions with the same phone and dob are one person.
  @@unique([phone, dob], map: "patients_phone_dob_unique")
  @@index([email], map: "patients_email_idx")
  @@map("patients")
}

/// The relationship between a tenant and a person. Tenants read only through this.
model TenantPatient {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  patientId         String   @db.Uuid
  /// The tenant's own id for this patient (e.g. a GHL contact id).
  externalContactId String?  @db.VarChar(255)
  firstSeenAt       DateTime @default(now()) @db.Timestamptz(6)
  isActive          Boolean  @default(true)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([tenantId, patientId], map: "tenant_patients_unique")
  @@index([tenantId, isActive], map: "tenant_patients_tenant_active_idx")
  @@map("tenant_patients")
}

model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @db.Uuid
  patientId      String          @db.Uuid
  providerId     String?         @db.Uuid
  type           EncounterType   @default(ASYNC_REVIEW)
  status         EncounterStatus @default(OPEN)
  occurredAt     DateTime        @db.Timestamptz(6)
  chiefComplaint String?         @db.VarChar(500)
  summary        String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  vitals   Vitals[]
  notes    ProviderNote[]

  @@index([tenantId, occurredAt], map: "encounters_tenant_occurred_idx")
  @@index([patientId, occurredAt], map: "encounters_patient_occurred_idx")
  @@map("encounters")
}

model Vitals {
  id               String   @id @default(uuid()) @db.Uuid
  patientId        String   @db.Uuid
  encounterId      String?  @db.Uuid
  heightIn         Decimal? @db.Decimal(5, 2)
  weightLbs        Decimal? @db.Decimal(6, 2)
  /// Derived in the service from height and weight. Never accepted from a client.
  bmi              Decimal? @db.Decimal(5, 2)
  systolic         Int?
  diastolic        Int?
  heartRate        Int?
  temperatureF     Decimal? @db.Decimal(4, 1)
  recordedAt       DateTime @db.Timestamptz(6)
  recordedByUserId String?  @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([patientId, recordedAt], map: "vitals_patient_recorded_idx")
  @@map("vitals")
}

model Allergy {
  id               String          @id @default(uuid()) @db.Uuid
  patientId        String          @db.Uuid
  substance        String          @db.VarChar(200)
  reactionText     String?
  severity         AllergySeverity @default(MILD)
  type             AllergyType     @default(DRUG)
  onsetDate        DateTime?       @db.Timestamptz(6)
  status           ClinicalStatus  @default(ACTIVE)
  recordedByUserId String?         @db.Uuid
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  patient          Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, status], map: "allergies_patient_status_idx")
  @@map("allergies")
}

model Condition {
  id               String         @id @default(uuid()) @db.Uuid
  patientId        String         @db.Uuid
  code             String?        @db.VarChar(40)
  display          String         @db.VarChar(300)
  onsetDate        DateTime?      @db.Timestamptz(6)
  resolvedDate     DateTime?      @db.Timestamptz(6)
  clinicalStatus   ClinicalStatus @default(ACTIVE)
  recordedByUserId String?        @db.Uuid
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  patient          Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, clinicalStatus], map: "conditions_patient_status_idx")
  @@map("conditions")
}

model PatientMedication {
  id           String           @id @default(uuid()) @db.Uuid
  patientId    String           @db.Uuid
  medicationId String?          @db.Uuid
  nameText     String           @db.VarChar(250)
  dose         String?          @db.VarChar(120)
  route        String?          @db.VarChar(80)
  frequency    String?          @db.VarChar(120)
  startDate    DateTime?        @db.Timestamptz(6)
  endDate      DateTime?        @db.Timestamptz(6)
  status       ClinicalStatus   @default(ACTIVE)
  source       MedicationSource @default(PATIENT_REPORTED)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  patient    Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medication Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([patientId, status], map: "patient_medications_patient_status_idx")
  @@map("patient_medications")
}

/// From the partner /lab/receiveLabResults endpoint. A FHIR Observation in spirit.
model LabResult {
  id              String    @id @default(uuid()) @db.Uuid
  patientId       String    @db.Uuid
  submissionId    String?   @db.Uuid
  screeningDate   DateTime  @db.Timestamptz(6)
  testName        String    @db.VarChar(200)
  testResult      String    @db.VarChar(200)
  testResultUnits String?   @db.VarChar(80)
  refRange        String?   @db.VarChar(120)
  /// H / L / N / N_A — derived from result vs range, not trusted from the caller.
  statusIndicator String    @db.VarChar(8)
  reportDate      DateTime? @db.Timestamptz(6)
  sampleSource    String?   @db.VarChar(40)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  patient    Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  submission QaSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([patientId, screeningDate], map: "lab_results_patient_screening_idx")
  @@map("lab_results")
}

/// Clinical notes are amended, never edited or deleted.
model ProviderNote {
  id           String    @id @default(uuid()) @db.Uuid
  encounterId  String    @db.Uuid
  providerId   String    @db.Uuid
  authorUserId String    @db.Uuid
  body         String
  isAmendment  Boolean   @default(false)
  amendsNoteId String?   @db.Uuid
  signedAt     DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  encounter Encounter       @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  provider  ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  amends    ProviderNote?   @relation("NoteAmendment", fields: [amendsNoteId], references: [id], onDelete: SetNull)
  amendedBy ProviderNote[]  @relation("NoteAmendment")

  @@index([encounterId, createdAt], map: "provider_notes_encounter_created_idx")
  @@map("provider_notes")
}

model PatientDocument {
  id               String       @id @default(uuid()) @db.Uuid
  patientId        String       @db.Uuid
  kind             DocumentKind @default(OTHER)
  bucket           String       @db.VarChar(255)
  objectKey        String       @db.VarChar(512)
  mime             String       @db.VarChar(120)
  size             Int
  fileName         String?      @db.VarChar(255)
  uploadedByUserId String?      @db.Uuid
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
