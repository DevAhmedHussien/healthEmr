# Optional. Each app reads its own file — see:
#
#   apps/health-emr-api/.env.example
#   apps/health-emr-web/.env.example
#
# This one exists only for tooling invoked from the repo root that expects a
# DATABASE_URL in scope. Nothing the apps do depends on it, and a value here
# does not reach either of them.
DATABASE_URL="postgresql://healthemr:healthemr@localhost:5455/healthemr?schema=public"
