# Copy to .env — shared by both apps for local tooling (Prisma CLI, scripts).
#
# The apps themselves read their own file, because both define PORT and one
# shared value means the second app to start takes the first one's port:
#   apps/health-emr-api/.env   PORT=4000
#   apps/health-emr-web/.env   PORT=3000

# --- database -------------------------------------------------------------
DATABASE_URL="postgresql://healthemr:healthemr@localhost:5455/healthemr?schema=public"

# --- api ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET="replace-me-access"
JWT_REFRESH_SECRET="replace-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
CORS_ORIGINS="http://localhost:3000"

# Field-level PHI encryption. 32 bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHI_ENCRYPTION_KEY=""

# --- web ------------------------------------------------------------------
API_BASE_URL="http://localhost:4000"
AUTH_SECRET="replace-me-auth"
AUTH_URL="http://localhost:3000"
